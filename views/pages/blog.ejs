<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {title:index_data.title, description:index_data.description}) %>
</head>
  
<body>

<div class="content">
  <%- include('../partials/header', {title:index_data.title}) %>
  <h2 class="page-subtitle">(called2voyage)</h2>

  <div class="purpleblock">
<img id="header-img" src="/images/<%= branding_data.header_img %>" alt="Picture of Josie - a brown haired, blue eyed woman with purple rimmed glasses" />
  <div class="pronouns">
    <span><%= index_data.pronouns %></span>
  </div>

  <div class="shortbio">
    <%= index_data.short_bio %>
  </div>
</div>

  <div class="tabs">
      <a href="/">About</a> |
      <div class="current-tab">Blog</div>
  </div>

  <div class="blog-index">
    <% posts.forEach(post => { %>
      <div>
        <a id="<%= post[1].attributes.slug %>" href="<%= post[0] %>"><h2 class="section-title"><%= post[1].attributes.title %></h2></a>
        <div style="text-align: left">
          <%- post[2] %>
        </div>
        <p style="margin-bottom: 2em"><small><em>Published: <%= post[1].attributes.date %></em></small></p>
      </div>
    <% }); %>
  </div>

</div>
    
<%- include('../partials/footer') %>
    
</body>
</html>